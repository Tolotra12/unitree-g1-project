        </g1_23dof/Physics/waist_support_joint>,
        </g1_23dof/Physics/left_shoulder_pitch_joint>,
        </g1_23dof/Physics/right_shoulder_pitch_joint>,
        </g1_23dof/Physics/left_shoulder_roll_joint>,
        </g1_23dof/Physics/left_shoulder_yaw_joint>,
        </g1_23dof/Physics/left_elbow_joint>,
        </g1_23dof/Physics/left_wrist_roll_joint>,
        </g1_23dof/Physics/right_shoulder_roll_joint>,
        </g1_23dof/Physics/right_shoulder_yaw_joint>,
        </g1_23dof/Physics/right_elbow_joint>,
        </g1_23dof/Physics/right_wrist_roll_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </g1_23dof/Geometry/pelvis>,
        </g1_23dof/Geometry/pelvis/pelvis_contour_link>,
        </g1_23dof/Geometry/pelvis/left_hip_pitch_link>,
