#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "g1_23dof"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "g1_23dof" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </g1_23dof/Physics/root_joint>,
        </g1_23dof/Physics/pelvis_contour_joint>,
        </g1_23dof/Physics/left_hip_pitch_joint>,
        </g1_23dof/Physics/right_hip_pitch_joint>,
