        </g1_23dof/Physics/left_knee_joint>,
        </g1_23dof/Physics/left_ankle_pitch_joint>,
        </g1_23dof/Physics/left_ankle_roll_joint>,
        </g1_23dof/Physics/right_hip_roll_joint>,
        </g1_23dof/Physics/right_hip_yaw_joint>,
        </g1_23dof/Physics/right_knee_joint>,
        </g1_23dof/Physics/right_ankle_pitch_joint>,
        </g1_23dof/Physics/right_ankle_roll_joint>,
